{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@packages/*": [
        "packages/*/src"
      ]
    }
  },
  "include": [
    "packages",
    "play"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}